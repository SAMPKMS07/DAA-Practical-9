import heapq

def prim(graph):
    n = len(graph)
    visited = [False] * n

    pq = [(0, 0)]       # (weight, vertex)
    total_cost = 0

    while pq:
        w, v = heapq.heappop(pq)

        if visited[v]:
            continue

        visited[v] = True
        total_cost += w

        for neigh, weight in graph[v]:
            heapq.heappush(pq, (weight, neigh))

    return total_cost


graph = [
    [(1, 2), (2, 3)],       # 0
    [(0, 2), (2, 1), (3, 4)],  # 1
    [(0, 3), (1, 1), (3, 2)],  # 2
    [(1, 4), (2, 2)]        # 3
]

print("Minimum Cost =", prim(graph))
